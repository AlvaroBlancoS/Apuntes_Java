{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Mail Service (Hot Reload)",
            "request": "launch",
            "mainClass": "springboot.token.mail.MailApplication",
            "projectName": "Mail",
            "cwd": "${workspaceFolder}/Mail",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build Mail",
            "vmArgs": "-Dspring.devtools.restart.enabled=true",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        },
        {
            "type": "java",
            "name": "User Service (Hot Reload)",
            "request": "launch",
            "mainClass": "springboot.token.user.UserApplication",
            "projectName": "User",
            "cwd": "${workspaceFolder}/User",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build User",
            "vmArgs": "-Dspring.devtools.restart.enabled=true",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        },
        {
            "type": "java",
            "name": "Token Service (Hot Reload)",
            "request": "launch",
            "mainClass": "springboot.token.token.TokenApplication",
            "projectName": "Token",
            "cwd": "${workspaceFolder}/Token",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build Token",
            "vmArgs": "-Dspring.devtools.restart.enabled=true",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        }
    ]
}