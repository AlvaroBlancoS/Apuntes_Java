{
    "version": "0.2.0",
    "configurations": [

        {
            "type": "java",
            "name": "Mail Service",
            "request": "launch",
            "mainClass": "springboot.feignclient.mail.MailApplication",
            "projectName": "Mail",
            "cwd": "${workspaceFolder}/Mail",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build Mail",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        },
        {
            "type": "java",
            "name": "Mail Service (Hot Reload)",
            "request": "launch",
            "mainClass": "springboot.feignclient.mail.MailApplication",
            "projectName": "Mail",
            "cwd": "${workspaceFolder}/Mail",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build Mail",
            "vmArgs": "-Dspring.devtools.restart.enabled=true",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        },

        {
            "type": "java",
            "name": "User Service",
            "request": "launch",
            "mainClass": "springboot.feignclient.user.UserApplication",
            "projectName": "User",
            "cwd": "${workspaceFolder}/User",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build User",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        },
        {
            "type": "java",
            "name": "User Service (Hot Reload)",
            "request": "launch",
            "mainClass": "springboot.feignclient.user.UserApplication",
            "projectName": "User",
            "cwd": "${workspaceFolder}/User",
            "console": "integratedTerminal",
            "preLaunchTask": "Maven: Build User",
            "vmArgs": "-Dspring.devtools.restart.enabled=true",
            "envFile": "${workspaceFolder}/.env/postgres.env"
        }
    ]
}