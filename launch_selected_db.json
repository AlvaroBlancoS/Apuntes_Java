{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "SpringData2 - Postgres",
            "request": "launch",
            "mainClass": "com.practice.springData2.SpringData2Application",
            "envFile": "${input:selectedEnvFile}",
            "projectName": "SpringData2"
        }
    ],
    "inputs": [
        {
            "id": "selectedEnvFile",
            "type": "pickString",
            "description": "Selecciona un archivo de env",
            "options": [
                "${workspaceFolder}/.env/mysql.env",
                "${workspaceFolder}/.env/postgres.env"
            ],
            "default": "${workspaceFolder}/.env/mysql.env"
        }
    ]
}
