{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "SpringData",
            "request": "launch",
            "mainClass": "com.practice.springData.SpringDataApplication",
            "envFile": "${input:selectedEnvFile}",
            "projectName": "SpringData"
        }
    ],
    "inputs": [
        {
            "id": "selectedEnvFile",
            "type": "pickString",
            "description": "Selecciona un archivo de env",
            "options": [
                "${workspaceFolder}/.env/mysql.env",
                "${workspaceFolder}/.env/postgresql.env"
            ],
            "default": "${workspaceFolder}/.env/mysql.env"
        }
    ]
}
